# Sao chép thành .env rồi điền (scripts/deploy.sh tự sinh các bí mật nếu .env chưa có). KHÔNG commit .env.
WEB_PORT=80
# Thư mục mã nguồn FE (mặc định cạnh repo BE)
# FE_DIR=../library-management-system-fe

AUTH_BOOTSTRAP_ADMIN_PASSWORD=
INTERNAL_API_KEY=
STOREFRONT_CLIENT_SECRET=
TENANT_DATA_ENCRYPTION_KEY=
EMAIL_VERIFICATION_OTP_SECRET=
# Cặp khóa ký JWT (PEM, xuống dòng thành \n hoặc để deploy.sh sinh)
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=

# SMTP thật để gửi OTP (mặc định Mailpit trong compose, thư không ra ngoài)
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

# SePay (thanh toán QR)
PAYMENTS_SEPAY_ENABLED=false
PAYMENTS_SEPAY_TOKEN=
PAYMENTS_SEPAY_BANK_BIN=
PAYMENTS_SEPAY_ACCOUNT_NO=
PAYMENTS_SEPAY_BANK_ACCOUNT_ID=
