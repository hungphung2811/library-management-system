<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.company</groupId>
    <artifactId>library-management-system</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>library-management-system</name>

    <modules>
        <module>shared-libraries/common-kernel</module>
        <module>shared-libraries/security-common</module>
        <module>shared-libraries/tenant-common</module>
        <module>shared-libraries/messaging-common</module>
        <module>shared-libraries/observability-common</module>
        <module>shared-libraries/database-common</module>
        <module>shared-libraries/demo-seed</module>
        <module>lms-api</module>
        <module>customer-api</module>
        <module>services/identity-service</module>
        <module>services/catalog-service</module>
        <module>services/circulation-service</module>
        <module>services/support-service</module>
        <module>services/sales-service</module>
        <module>services/system-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <springdoc.version>2.8.13</springdoc.version>
        <archunit.version>1.5.1</archunit.version>
        <commonmark.version>0.27.1</commonmark.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.company</groupId>
                <artifactId>common-kernel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.company</groupId>
                <artifactId>security-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.company</groupId>
                <artifactId>tenant-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.company</groupId>
                <artifactId>messaging-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.company</groupId>
                <artifactId>observability-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.company</groupId>
                <artifactId>database-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <!-- ADR-0018: kế hoạch dữ liệu demo + runner profile demo-seed -->
                <groupId>com.company</groupId>
                <artifactId>demo-seed</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <!-- ADR-0011: render Markdown của context cms (system-service) -->
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark</artifactId>
                <version>${commonmark.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
